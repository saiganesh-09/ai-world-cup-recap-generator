# ── Required ──────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local dev default (npm run db:start → embedded postgres on :5433):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/worldcup"

# Public base URL of the app (used for absolute links / OG tags)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Optional — app works fully in demo mode without these ─────────────
# OpenAI API key. When unset, the deterministic fallback narrative engine
# and synthesized audio are used instead of AI narration.
OPENAI_API_KEY=""

# Model overrides (defaults shown)
OPENAI_TEXT_MODEL="gpt-4o-mini"
OPENAI_TTS_MODEL="gpt-4o-mini-tts"
OPENAI_WHISPER_MODEL="whisper-1"

# API-Football compatible sports data provider.
# When unset, the built-in demo dataset (seeded into Postgres) is used.
SPORTS_API_KEY=""
SPORTS_API_BASE_URL="https://v3.football.api-sports.io"
SPORTS_API_LEAGUE_ID="1"        # API-Football league id for the World Cup
SPORTS_API_SEASON="2022"

# Auth session cookie lifetime (days)
SESSION_TTL_DAYS="30"

# Rate limits (requests per window)
RATE_LIMIT_GENERATE="5"         # recap generations / hour / user
RATE_LIMIT_TRANSCRIBE="10"      # transcriptions / hour / user
