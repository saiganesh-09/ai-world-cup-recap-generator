# ── Database ────────────────────────────────────────────────
# Local: uses docker-compose Postgres. Prod: Neon/Supabase URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/worldcup?schema=public"

# ── AI ──────────────────────────────────────────────────────
# Optional. Without it the app runs in deterministic demo mode
# (template-based recap generation, no video narration).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ── External sports data (optional) ─────────────────────────
# Optional. Without it the app serves seeded tournament data.
SPORTS_API_KEY=""
SPORTS_API_BASE_URL="https://v3.football.api-sports.io"

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"

# ── Media storage ───────────────────────────────────────────
# "local" writes generated videos to /public/generated.
# Set "s3" to use S3-compatible object storage in production.
MEDIA_STORAGE="local"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""

# ── Rate limiting ───────────────────────────────────────────
# Max recap generations per user per hour.
RATE_LIMIT_RECAPS_PER_HOUR="5"
